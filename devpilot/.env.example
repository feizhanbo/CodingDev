# DevPilot Configuration (copy to .env and fill in values)

# LLM Configuration
DEVPILOT_API_KEY=your-api-key-here
DEVPILOT_MODEL=glm-5.2
# DEVPILOT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  # Custom OpenAI-compatible endpoint

# Runtime Limits
DEVPILOT_MAX_STEPS=30
DEVPILOT_MAX_TEST_RETRIES=3
DEVPILOT_MAX_MODIFIED_FILES=10
DEVPILOT_MAX_PATCH_FAILURES=3
DEVPILOT_TEST_TIMEOUT_SECONDS=120

# Target interpreter must include the target repository test dependencies.
# DEVPILOT_TEST_PYTHON=../shopflow-order-service/.venv/Scripts/python.exe

# Security
DEVPILOT_NETWORK_ACCESS=false

# Paths
DEVPILOT_WORKSPACE_ROOT=./workspaces
DEVPILOT_RUNS_ROOT=./runs
DEVPILOT_BASE_REPO=../shopflow-order-service

# Request and wall-clock limits (trusted local execution; no OS/network isolation)
DEVPILOT_MAX_LLM_REQUESTS=90
DEVPILOT_LLM_TIMEOUT_SECONDS=120
DEVPILOT_MAX_RUN_SECONDS=1800
DEVPILOT_WORKSPACE_MAX_BYTES=268435456
DEVPILOT_WORKSPACE_TOTAL_MAX_BYTES=2147483648

# Bounded test logs and artifact admission (diagnostic JSON is preserved on refusal)
DEVPILOT_MAX_TEST_OUTPUT_BYTES=2097152
DEVPILOT_RUN_ARTIFACTS_MAX_BYTES=536870912
DEVPILOT_RUNS_TOTAL_MAX_BYTES=4294967296
